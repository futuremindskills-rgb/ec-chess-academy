generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- ENUMS ---

enum TournamentStatus {
  OPEN
  ONGOING
  COMPLETED
  CANCELLED
}

enum RegistrationStatus {
  PENDING
  COMPLETED
  FAILED
}

// --- TOURNAMENTS ---

model Tournament {
  id           Int              @id @default(autoincrement())
  title        String
  description  String           @db.Text
  entryFee     Int              // stored in smallest currency unit (e.g. cents)
  maxPlayers   Int
  startDate    DateTime
  endDate      DateTime
  location     String
  bannerImage  String?
  status       TournamentStatus @default(OPEN)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @default(now()) @updatedAt
  
  registrations Registration[]
}

// --- REGISTRATIONS (UPDATED WITH STUDENT DETAILS) ---

model Registration {
  id              String             @id @default(cuid())
  playerName      String
  email           String
  phone           String
  
  // --- New Detailed Fields ---
  dob             DateTime           // Date of Birth
  gender          String             // Male / Female / Other
  studentCategory String             // Lower primary / Upper / secondary / college / open
  rating          String?            // Rating or Level (Optional)
  fideId          String?            // FIDE ID (Optional)
  onlineUsername  String?            // Lichess or Chess.com username
  // ---------------------------

  status          RegistrationStatus @default(PENDING)
  
  tournamentId    Int
  tournament      Tournament         @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  
  stripeSessionId String?            @unique
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @default(now()) @updatedAt
}

// --- BLOGS ---

model BlogPost {
  id           Int      @id @default(autoincrement())
  title        String
  excerpt      String   @db.Text
  content      String   @db.Text
  category     String   
  readTime     String
  image        String
  slug         String   @unique
  featured     Boolean  @default(false)
  date         DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt
}

// --- ALBUM-BASED GALLERY ---

model Album {
  id           Int          @id @default(autoincrement())
  title        String
  description  String?      @db.Text
  category     String       
  images       AlbumImage[] 
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @default(now()) @updatedAt
}

model AlbumImage {
  id      Int    @id @default(autoincrement())
  src     String 
  albumId Int
  album   Album  @relation(fields: [albumId], references: [id], onDelete: Cascade)
}

// --- ENQUIRIES ---

model Enquiry {
  id          Int      @id @default(autoincrement())
  parentName  String
  studentName String?
  email       String
  phone       String
  subject     String   
  message     String   @db.Text
  status      String   @default("New") 
  notes       String?  @db.Text
  createdAt   DateTime @default(now())
}