generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- ENUMS ---

enum TournamentStatus {
  OPEN
  ONGOING
  COMPLETED
  CANCELLED
}

enum RegistrationStatus {
  PENDING
  COMPLETED
  FAILED
}

// --- TOURNAMENTS ---

model Tournament {
  id             Int            @id @default(autoincrement())
  title          String
  description    String?
  entryFee       Int
  maxPlayers     Int
  startDate      DateTime
  endDate        DateTime
  location       String
  bannerImage    String?

  categories     String?        // Existing field for categories
  levels         String?        // <-- ADD THIS: Stores JSON array of levels (e.g., '["Level 1", "Level 2"]')
  regulations    String?        @db.Text

  status         String         @default("OPEN")
  registrations  Registration[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @default(now()) @updatedAt
}

// --- REGISTRATIONS ---

model Registration {
  id              String             @id @default(cuid())
  playerName      String
  email           String
  phone           String
  
  dob             DateTime           
  gender          String             
  studentCategory String             
  
  // This field stays as is; it will store the value selected 
  // from the dynamic dropdown we built in the UI.
  rating          String?            

  fideId          String?            
  
  // This is already optional because of the '?'
  onlineUsername  String?            

  status          RegistrationStatus @default(PENDING)
  
  tournamentId    Int
  tournament      Tournament         @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  
  stripeSessionId String?            @unique
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @default(now()) @updatedAt
}
// --- BLOGS ---

model BlogPost {
  id           Int      @id @default(autoincrement())
  title        String
  excerpt      String   @db.Text
  content      String   @db.Text
  category     String   
  readTime     String
  image        String
  slug         String   @unique
  featured     Boolean  @default(false)
  date         DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt
}

// --- ALBUM-BASED GALLERY ---

model Album {
  id           Int          @id @default(autoincrement())
  title        String
  description  String?      @db.Text
  category     String       
  images       AlbumImage[] 
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @default(now()) @updatedAt
}

model AlbumImage {
  id      Int    @id @default(autoincrement())
  src     String 
  albumId Int
  album   Album  @relation(fields: [albumId], references: [id], onDelete: Cascade)
}

// --- ENQUIRIES ---

model Enquiry {
  id          Int      @id @default(autoincrement())
  parentName  String
  studentName String?
  email       String
  phone       String
  subject     String   
  message     String   @db.Text
  status      String   @default("New") 
  notes       String?  @db.Text
  createdAt   DateTime @default(now())
}

// --- SITE SETTINGS / BANNER ---

model SiteBanner {
  id          Int      @id @default(1)
  imageUrl    String?  // The uploaded banner image
  link        String?  // Optional link when clicking the banner
  isActive    Boolean  @default(false)
  updatedAt   DateTime @updatedAt
}