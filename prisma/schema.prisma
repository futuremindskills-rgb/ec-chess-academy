generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- ENUMS ---

enum TournamentStatus {
  OPEN
  ONGOING
  COMPLETED
  CANCELLED
}

enum RegistrationStatus {
  PENDING
  COMPLETED
  FAILED
}

// --- TOURNAMENTS ---

model Tournament {
  id             Int              @id @default(autoincrement())
  title          String
  description    String?          @db.Text
  entryFee       Int              // The amount to be sent to AsiaPay
  maxPlayers     Int
  startDate      DateTime
  endDate        DateTime
  location       String
  bannerImage    String?

  categories     String?          // Existing field for categories
  levels         String?          // Stores JSON array of levels (e.g., '["Level 1", "Level 2"]')
  regulations    String?          @db.Text

  status         TournamentStatus @default(OPEN)
  
  // RELATION FIELDS
  registrations  Registration[]
  coupons        Coupon[]         // <--- THIS WAS THE MISSING LINE
  
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

model Coupon {
  id             Int      @id @default(autoincrement())
  code           String   @unique // e.g., "EARLYBIRD50"
  discountType   String   // "PERCENT" or "FIXED"
  discountValue  Int      // 50 for 50% or 50 for HK$50
  expiryDate     DateTime?
  usageLimit     Int?     // Maximum number of times this can be used
  usedCount      Int      @default(0)
  tournamentId   Int?     // If null, it's valid for ALL tournaments
  tournament     Tournament? @relation(fields: [tournamentId], references: [id])
  createdAt      DateTime @default(now())
}

// --- REGISTRATIONS ---

model Registration {
  id              String             @id @default(cuid())
  playerName      String
  email           String
  phone           String
  dob             DateTime           
  gender          String             
  studentCategory String             
  rating          String?            
  fideId          String?            
  onlineUsername  String?            
  
  status          RegistrationStatus @default(PENDING)
  
  // --- PAYMENT TRACKING FIELDS ---
  paymentGateway  String?            // "stripe" or "asiapay"
  transactionId   String?            @unique // Stores AsiaPay "payRef" or Stripe "PaymentIntent ID"
  stripeSessionId String?            @unique // Specific for Stripe checkout sessions
  // ------------------------------

  tournamentId    Int
  tournament      Tournament         @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
}

// --- BLOGS ---

model BlogPost {
  id           Int      @id @default(autoincrement())
  title        String
  excerpt      String   @db.Text
  content      String   @db.Text
  category     String   
  readTime     String
  image        String
  slug         String   @unique
  featured     Boolean  @default(false)
  date         DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// --- ALBUM-BASED GALLERY ---

model Album {
  id           Int          @id @default(autoincrement())
  title        String
  description  String?      @db.Text
  category     String       
  images       AlbumImage[] 
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model AlbumImage {
  id      Int    @id @default(autoincrement())
  src     String 
  albumId Int
  album   Album  @relation(fields: [albumId], references: [id], onDelete: Cascade)
}

// --- ENQUIRIES ---

model Enquiry {
  id          Int      @id @default(autoincrement())
  parentName  String
  studentName String?
  email       String
  phone       String
  subject     String   
  message     String   @db.Text
  status      String   @default("New") 
  notes       String?  @db.Text
  createdAt   DateTime @default(now())
}

// --- SITE SETTINGS / BANNER ---

model SiteBanner {
  id          Int      @id @default(1)
  imageUrl    String?  
  link        String?  
  isActive    Boolean  @default(false)
  updatedAt   DateTime @updatedAt
}