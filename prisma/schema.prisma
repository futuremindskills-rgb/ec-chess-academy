generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- ENUMS (CRITICAL: These define the allowed statuses) ---

enum TournamentStatus {
  OPEN
  ONGOING
  COMPLETED
  CANCELLED
}

enum RegistrationStatus {
  PENDING
  COMPLETED
  FAILED
}

// --- TOURNAMENTS ---

model Tournament {
  id           Int              @id @default(autoincrement())
  title        String
  description  String
  entryFee     Int              // stored in smallest currency unit (e.g. cents for HKD)
  maxPlayers   Int
  startDate    DateTime
  endDate      DateTime
  location     String
  bannerImage  String?
  status       TournamentStatus @default(OPEN)
  createdAt    DateTime         @default(now())
  
  // Relation to registrations
  registrations Registration[]
}

// --- REGISTRATIONS ---

model Registration {
  id           String             @id @default(cuid())
  playerName   String
  email        String
  phone        String
  status       RegistrationStatus @default(PENDING)
  
  // Link to Tournament
  tournamentId Int
  tournament   Tournament         @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  
  stripeSessionId String?         @unique
  createdAt       DateTime        @default(now())
}

// --- BLOGS ---

model BlogPost {
  id        Int      @id @default(autoincrement())
  title     String
  excerpt   String
  content   String   @db.Text
  category  String   
  readTime  String
  image     String
  slug      String   @unique
  featured  Boolean  @default(false)
  date      DateTime @default(now())
}

// --- GALLERY ---

model GalleryImage {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  category    String   
  src         String   
  createdAt   DateTime @default(now())
}

// --- ENQUIRIES ---

model Enquiry {
  id          Int      @id @default(autoincrement())
  parentName  String
  studentName String?
  email       String
  phone       String
  subject     String   
  message     String
  status      String   @default("New") 
  notes       String?  
  createdAt   DateTime @default(now())
}